# =============================================================================
# Variables de entorno — Centro de Recursos Amauta
# Copiá este archivo como referencia. NO pongas valores reales ni secretos acá.
# Cargá los valores en el proyecto de Vercel (o en .env.development.local).
# =============================================================================

# --- Base de datos (Neon / Postgres) ---------------------------------------
DATABASE_URL=

# --- Better Auth ------------------------------------------------------------
# Secreto para firmar sesiones. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Acceso corporativo "colaborador Amauta" (Entra ID, flujo PKCE) ---------
# El client_id y tenant son públicos (no secretos). Ver lib/b2c.ts.
AZURE_B2C_CLIENT_ID=

# --- Envío de emails de recuperación (Microsoft Graph / Microsoft 365) ------
# IMPORTANTE: estas credenciales son del tenant CORPORATIVO de Microsoft 365
# donde vive la casilla remitente. NO reutilizar las credenciales del tenant
# B2C ni las del acceso "colaborador Amauta".
#
# App Registration con permiso de APLICACIÓN Mail.Send (con admin consent),
# idealmente restringido a la casilla remitente vía Application Access Policy.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
# Casilla remitente (mailbox real con licencia), ej: no-reply@amauta.ag
MICROSOFT_GRAPH_SENDER_EMAIL=
