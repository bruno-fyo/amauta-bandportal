# =============================================================================
# Variables de entorno — Centro de Recursos Amauta
# Copiá este archivo como referencia. NO pongas valores reales ni secretos acá.
# Cargá los valores en el proyecto de Vercel (o en .env.development.local).
# =============================================================================

# --- Base de datos (Neon / Postgres) ---------------------------------------
DATABASE_URL=

# --- Better Auth ------------------------------------------------------------
# Secreto para firmar sesiones. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Acceso corporativo "colaborador Amauta" (Entra ID, flujo PKCE) ---------
# El client_id y tenant son públicos (no secretos). Ver lib/b2c.ts.
AZURE_B2C_CLIENT_ID=

# --- Envío del OTP de recuperación (webhook seguro de n8n) ------------------
# El servidor hace POST JSON a esta URL con Authorization: Bearer <secret>.
# n8n se encarga del envío real del correo. No poner valores reales acá.
N8N_PASSWORD_RESET_WEBHOOK_URL=
N8N_PASSWORD_RESET_WEBHOOK_SECRET=
